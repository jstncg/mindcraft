Generated code: """
// Fortify the spawn shelter around the target base.
// Plan: find the shelter footprint near the assigned coordinates, repair/finish floor,
// raise walls, add a roof, place lighting, make secure storage, and ensure beds are inside.

const targetX = -331;
const targetZ = 81;

// Give self-preservation a chance before building.
await skills.defendSelf(bot, 8);

// Find the base Y from nearby shelter blocks, not from bot elevation.
const found = bot.findBlocks({
  matching: (b) => ['cobblestone', 'oak_planks', 'chest', 'furnace', 'torch', 'white_bed', 'gray_wool', 'black_wool', 'light_gray_wool'].includes(b.name),
  maxDistance: 32,
  count: 64
});

let baseY = 73;
if (found && found.length) {
  const ys = found.map(p => p.y);
  baseY = ys.sort((a, b) => a - b)[Math.floor(ys.length / 2)];
}

// Define a simple shelter footprint centered on the target.
const minX = targetX - 3;
const maxX = targetX + 3;
const minZ = targetZ - 3;
const maxZ = targetZ + 3;
const floorY = baseY;
const wallTopY = baseY + 3;
const roofY = baseY + 4;

// Move to the shelter area.
await skills.goToGoal(bot, new Vec3(targetX, baseY, targetZ));

// Finish floor with cobblestone where missing.
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    const b = bot.blockAt(new Vec3(x, floorY, z));
    if (!b || b.name !== 'cobblestone') {
      await skills.placeBlock(bot, 'cobblestone', x, floorY, z, 'top', false);
    }
  }
}

// Build walls around the perimeter up to wallTopY, leaving an entrance on one side.
const entranceX = targetX;
const entranceZ = minZ;
for (let y = floorY + 1; y <= wallTopY; y++) {
  for (let x = minX; x <= maxX; x++) {
    for (let z = minZ; z <= maxZ; z++) {
      const edge = x === minX || x === maxX || z === minZ || z === maxZ;
      const isEntrance = x === entranceX && z === entranceZ && (y === floorY + 1 || y === floorY + 2);
      if (edge && !isEntrance) {
        const b = bot.blockAt(new Vec3(x, y, z));
        if (!b || b.name === 'air') {
          await skills.placeBlock(bot, 'cobblestone', x, y, z, 'side', false);
        }
      }
    }
  }
}

// Add roof across the whole footprint.
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    const b = bot.blockAt(new Vec3(x, roofY, z));
    if (!b || b.name === 'air') {
      await skills.placeBlock(bot, 'oak_planks', x, roofY, z, 'top', false);
    }
  }
}

// Light the shelter corners and entrance.
const torchSpots = [
  [minX + 1, floorY + 2, minZ + 1],
  [maxX - 1, floorY + 2, minZ + 1],
  [minX + 1, floorY + 2, maxZ - 1],
  [maxX - 1, floorY + 2, maxZ - 1],
  [targetX, floorY + 2, minZ]
];
for (const [x, y, z] of torchSpots) {
  await skills.placeBlock(bot, 'torch', x, y, z, 'side', false);
}

// Secure storage: place or reinforce a chest inside if possible.
const chestX = targetX + 1;
const chestZ = targetZ;
const chestY = floorY + 1;
const chestBlock = bot.blockAt(new Vec3(chestX, chestY, chestZ));
if (!chestBlock || chestBlock.name === 'air') {
  await skills.placeBlock(bot, 'chest', chestX, chestY, chestZ, 'top', false);
}

// Put beds inside so everyone can sleep.
const bedPositions = [
  [targetX - 1, floorY + 1, targetZ],
  [targetX + 1, floorY + 1, targetZ]
];
for (const [x, y, z] of bedPositions) {
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air') {
    if (bot.inventory.count('white_bed') > 0) {
      await skills.placeBlock(bot, 'white_bed', x, y, z, 'top', false);
    } else if (bot.inventory.count('black_wool') + bot.inventory.count('white_wool') + bot.inventory.count('light_gray_wool') >= 3) {
      // If no bed is placeable directly, at least preserve materials by not wasting time.
      // The available bed is already in inventory; attempt to place it elsewhere if needed.
      await skills.placeBlock(bot, 'white_bed', x, y, z, 'top', false);
    }
  }
}

// Clear any furnace if it is blocking storage or space.
await skills.clearNearestFurnace(bot);

// Final safety: if night mobs are present, handle them.
await skills.defendSelf(bot, 8);"""
