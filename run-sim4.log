// Scan the shelter perimeter and place planks to build/reinforce walls
const center = bot.entity.position.floored();
log(bot,`Current position: ${center}`);

// Find all oak_planks and cobblestone nearby to understand shelter bounds
const structureBlocks = bot.findBlocks({
    matching: (block) => ['oak_planks', 'cobblestone'].includes(block.name),
    maxDistance: 16,
    count: 200
});

log(bot,`Found ${structureBlocks.length} structure blocks nearby.`);

if (structureBlocks.length > 0) {
    let minX = Infinity, maxX = -Infinity;
    let minY = Infinity, maxY = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;

    for (const b of structureBlocks) {
        if (b.x < minX) minX = b.x;
        if (b.x > maxX) maxX = b.x;
        if (b.y < minY) minY = b.y;
        if (b.y > maxY) maxY = b.y;
        if (b.z < minZ) minZ = b.z;
        if (b.z > maxZ) maxZ = b.z;
    }
    log(bot,`Shelter bounds estimate: X[${minX}, ${maxX}] Y[${minY}, ${maxY}] Z[${minZ}, ${maxZ}]`);

    // Let's check for gaps along the perimeter at y=69, 70, 71
    // We want solid walls up to y=minY+2 or minY+3
    const targetHeight = Math.max(minY + 2, 71);
    let placed = 0;

    // Scan perimeter walls
    // Perimeter defined by minX, maxX, minZ, maxZ
    // But verify if bounds are reasonable (e.g. within 12 blocks)
    if (maxX - minX <= 12 && maxZ - minZ <= 12 && maxX - minX >= 3 && maxZ - minZ >= 3) {
        for (let y = minY; y <= targetHeight; y++) {
            // North & South walls
            for (let x = minX; x <= maxX; x++) {
                for (let z of [minZ, maxZ]) {
                    // Don't block door (leave 1 opening if already open or let's inspect air)
                    const block = bot.blockAt(new Vec3(x, y, z));
                    if (block && (block.name === 'air' || block.name === 'short_grass')) {
                        // Check if we have planks
                        const plankItem = bot.inventory.items().find(i => i.name === 'oak_planks');
                        if (!plankItem || plankItem.count < 2) break;
                        
                        // Check if adjacent block exists to place against
                        const success = await skills.placeBlock(bot, 'oak_planks', x, y, z);
                        if (success) {
                            placed++;
                            await skills.wait(bot, 250);
                        }
                    }
                }
            }
            // East & West walls
            for (let z = minZ; z <= maxZ; z++) {
                for (let x of [minX, maxX]) {
                    const block = bot.blockAt(new Vec3(x, y, z));
                    if (block && (block.name === 'air' || block.name === 'short_grass')) {
                        const plankItem = bot.inventory.items().find(i => i.name === 'oak_planks');
                        if (!plankItem || plankItem.count < 2) break;

                        const success = await skills.placeBlock(bot, 'oak_planks', x, y, z);
                        if (success) {
                            placed++;
                            await skills.wait(bot, 250);
                        }
                    }
                }
            }
        }
    } else {
        log(bot,"Bounds seem irregular or too large. Building locally around gap at south wall.");
        // Try placing at south wall gap around -332, 69..71, 85/86
        for (let y = 69; y <= 71; y++) {
            const block = bot.blockAt(new Vec3(-332, y, 86));
            if (block && (block.name === 'air' || block.name === 'short_grass')) {
                await skills.placeBlock(bot, 'oak_planks', -332, y, 86);
                placed++;
            }
        }
    }
    log(bot,`Placed ${placed} blocks.`);
} else {
    log(bot,"No structure blocks found nearby.");
}"""
