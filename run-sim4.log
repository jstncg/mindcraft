Generated code: """// Find the roof level and bounds, then patch remaining gaps in the roof and upper walls
let blocks = bot.findBlocks({
    matching: (b) => b && (b.name === 'oak_planks' || b.name === 'cobblestone'),
    maxDistance: 20,
    count: 300
});

if (blocks.length === 0) {
    bot.chat("No shelter blocks found nearby.");
} else {
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;
    let minY = Infinity, maxY = -Infinity;

    for (const b of blocks) {
        if (b.x < minX) minX = b.x;
        if (b.x > maxX) maxX = b.x;
        if (b.z < minZ) minZ = b.z;
        if (b.z > maxZ) maxZ = b.z;
        if (b.y < minY) minY = b.y;
        if (b.y > maxY) maxY = b.y;
    }

    bot.chat(`Shelter bounds: X [${minX}, ${maxX}], Z [${minZ}, ${maxZ}], Y [${minY}, ${maxY}]`);
    let roofY = maxY;

    let placedCount = 0;
    // Patch roof gaps
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            if (placedCount >= 12) break;
            let block = bot.blockAt(new Vec3(x, roofY, z));
            if (block && block.name === 'air') {
                // Must have at least one adjacent solid block to place against
                let neighbors = [
                    bot.blockAt(new Vec3(x + 1, roofY, z)),
                    bot.blockAt(new Vec3(x - 1, roofY, z)),
                    bot.blockAt(new Vec3(x, roofY, z + 1)),
                    bot.blockAt(new Vec3(x, roofY, z - 1)),
                    bot.blockAt(new Vec3(x, roofY - 1, z))
                ];
                let canPlace = neighbors.some(n => n && n.name !== 'air' && !n.name.includes('sapling') && !n.name.includes('grass'));
                if (canPlace) {
                    let success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                    if (success) {
                        placedCount++;
                        await skills.wait(bot, 200);
                    }
                }
            }
        }
    }

    bot.chat(`Patched ${placedCount} gaps at roof height ${roofY}.`);
}"""
