// Scan the shelter around (-331, 81) to find walls and gaps
const center = new Vec3(-331, 71, 81);

// Find existing shelter floor / wall / roof blocks
const existingCobble = bot.findBlocks({
    point: center,
    matching: (b) => b && (b.name === 'cobblestone' || b.name === 'oak_planks'),
    maxDistance: 10,
    count: 100
});

if (existingCobble.length === 0) {
    bot.chat("I don't see existing shelter blocks nearby to build upon.");
} else {
    // Find base Y from discovered blocks
    let minY = Infinity;
    let maxY = -Infinity;
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;

    for (const pos of existingCobble) {
        if (pos.y < minY) minY = pos.y;
        if (pos.y > maxY) maxY = pos.y;
        if (pos.x < minX) minX = pos.x;
        if (pos.x > maxX) maxX = pos.x;
        if (pos.z < minZ) minZ = pos.z;
        if (pos.z > maxZ) maxZ = pos.z;
    }

    bot.chat(`Shelter bounds detected: X[${minX}, ${maxX}] Y[${minY}, ${maxY}] Z[${minZ}, ${maxZ}]`);

    // Let's look for gaps in the perimeter walls between minY + 1 and maxY - 1
    // A wall block should be on the perimeter (x == minX or x == maxX or z == minZ or z == maxZ)
    let placedCount = 0;
    
    // Check perimeter positions
    for (let y = minY + 1; y <= Math.min(minY + 3, maxY); y++) {
        for (let x = minX; x <= maxX; x++) {
            for (let z = minZ; z <= maxZ; z++) {
                const isPerimeter = (x === minX || x === maxX || z === minZ || z === maxZ);
                if (!isPerimeter) continue;

                // Check block at this position
                const targetPos = new Vec3(x, y, z);
                const block = bot.blockAt(targetPos);
                
                // If it's air or replaceable (like grass)
                if (block && (block.name === 'air' || block.name === 'short_grass' || block.name === 'tall_grass')) {
                    // Check if block below is solid so we can place
                    const blockBelow = bot.blockAt(targetPos.offset(0, -1, 0));
                    if (blockBelow && blockBelow.boundingBox === 'block') {
                        // Avoid sealing a doorway if there's only one gap? 
                        // But shelter needs solid walls. Let's leave one 2-high gap if needed, or fill open holes.
                        // Let's place cobblestone here!
                        const cobbleItem = bot.inventory.items().find(i => i.name === 'cobblestone');
                        if (!cobbleItem) {
                            bot.chat("I've run out of cobblestone!");
                            break;
                        }

                        // Don't stand inside the block we're placing
                        const botPos = bot.entity.position;
                        if (botPos.distanceTo(targetPos) < 1.3) {
                            continue;
                        }

                        bot.chat(`Placing cobblestone at ${x}, ${y}, ${z} to reinforce the wall.`);
                        const success = await skills.placeBlock(bot, 'cobblestone', x, y, z, 'top');
                        if (success) {
                            placedCount++;
                            await skills.wait(bot, 300);
                        }
                        if (placedCount >= 10) break;
                    }
                }
            }
            if (placedCount >= 10) break;
        }
        if (placedCount >= 10) break;
    }

    if (placedCount === 0) {
        bot.chat("No obvious wall gaps found along the immediate perimeter, or positions obstructed.");
    } else {
        bot.chat(`Successfully reinforced shelter with ${placedCount} cobblestone blocks.`);
    }
}```
