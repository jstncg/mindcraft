// Check existing cobblestone to determine structure base Y and layout
const cobbleBlocks = bot.findBlocks({
  matching: (block) => block && block.name === 'cobblestone',
  maxDistance: 16,
  count: 50
});

bot.chat(`Found ${cobbleBlocks.length} cobblestone blocks nearby.`);

if (cobbleBlocks.length > 0) {
  // Find minimum and maximum Y among nearby cobblestone
  let minY = 999;
  let maxY = -999;
  for (const pos of cobbleBlocks) {
    if (pos.y < minY) minY = pos.y;
    if (pos.y > maxY) maxY = pos.y;
  }

  bot.chat(`Cobblestone Y ranges from ${minY} to ${maxY}.`);

  // Let's build up the wall or close the perimeter.
  // We have 10 cobblestone. Let's see where cobblestone can be placed.
  // If base Y is known, let's place cobblestone at y = maxY or extend along z=86 / side walls.
  // Let's check positions at z=86 or adjacent to enclose the shelter.
  
  // We want to raise the wall to height 3 (minY + 2) or place next segment.
  const targetY = minY + 2; // 3rd layer
  bot.chat(`Target layer for wall height: y=${targetY}`);

  let placed = 0;
  for (let x = -336; x <= -332; x++) {
    if (bot.inventory.count(bot.registry.itemsByName.cobblestone.id) <= 0) break;
    const checkPos = new Vec3(x, targetY, 86);
    const blk = bot.blockAt(checkPos);
    const below = bot.blockAt(new Vec3(x, targetY - 1, 86));

    if (blk && blk.name === 'air' && below && below.name !== 'air') {
      const success = await skills.placeBlock(bot, 'cobblestone', x, targetY, 86, 'top');
      if (success) {
        placed++;
        await skills.wait(bot, 200);
      }
    }
  }

  // If layer 3 was already done or couldn't place, try side wall (e.g. x=-336, z=85..82)
  if (placed < 3) {
    for (let z = 85; z >= 82; z--) {
      if (bot.inventory.count(bot.registry.itemsByName.cobblestone.id) <= 0) break;
      for (let y = minY; y <= minY + 1; y++) {
        if (bot.inventory.count(bot.registry.itemsByName.cobblestone.id) <= 0) break;
        const checkPos = new Vec3(-336, y, z);
        const blk = bot.blockAt(checkPos);
        if (blk && (blk.name === 'air' || blk.name === 'short_grass')) {
          if (blk.name === 'short_grass') {
            await skills.breakBlockAt(bot, checkPos.x, checkPos.y, checkPos.z);
          }
          const success = await skills.placeBlock(bot, 'cobblestone', -336, y, z);
          if (success) {
            placed++;
            await skills.wait(bot, 200);
          }
        }
      }
    }
  }

  bot.chat(`Placed ${placed} cobblestone blocks for shelter construction.`);
} else {
  bot.chat("No cobblestone found nearby, placing foundation at current location.");
  const p = world.getPosition(bot);
  await skills.placeBlock(bot, 'cobblestone', p.x + 1, p.y, p.z);
}```
