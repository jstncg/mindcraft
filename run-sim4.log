// Scan existing shelter blocks to determine accurate bounds and base Y
const center = new Vec3(-331, 69, 83);
const structureBlocks = bot.findBlocks({
    point: center,
    matching: (b) => b && (b.name === 'cobblestone' || b.name === 'oak_planks' || b.name === 'white_bed' || b.name === 'furnace' || b.name === 'chest'),
    maxDistance: 12,
    count: 120
});

if (structureBlocks.length === 0) {
    bot.chat("No shelter structure blocks found nearby.");
} else {
    let minY = Infinity, maxY = -Infinity;
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;

    for (const pos of structureBlocks) {
        if (pos.y < minY) minY = pos.y;
        if (pos.y > maxY) maxY = pos.y;
        if (pos.x < minX) minX = pos.x;
        if (pos.x > maxX) maxX = pos.x;
        if (pos.z < minZ) minZ = pos.z;
        if (pos.z > maxZ) maxZ = pos.z;
    }

    bot.chat(`Shelter bounds: X[${minX}, ${maxX}] Y[${minY}, ${maxY}] Z[${minZ}, ${maxZ}]`);

    let cobbleItem = bot.inventory.items().find(i => i.name === 'cobblestone');
    if (!cobbleItem) {
        bot.chat("I have no cobblestone left to place.");
    } else {
        let placedCount = 0;

        // First pass: Wall height up to minY + 3 along perimeter
        const wallHeight = minY + 3;
        for (let y = minY + 1; y <= wallHeight; y++) {
            for (let x = minX; x <= maxX; x++) {
                for (let z = minZ; z <= maxZ; z++) {
                    const isPerimeter = (x === minX || x === maxX || z === minZ || z === maxZ);
                    if (!isPerimeter) continue;

                    // Leave one 1x2 opening for entrance at (minX, minY+1, centerZ) or similar if not sealed, but shelter needs solid perimeter
                    const targetPos = new Vec3(x, y, z);
                    const b = bot.blockAt(targetPos);
                    if (b && (b.name === 'air' || b.name === 'short_grass' || b.name === 'tall_grass')) {
                        // Check if adjacent to solid block
                        const adjSolid = [
                            targetPos.offset(0, -1, 0),
                            targetPos.offset(1, 0, 0),
                            targetPos.offset(-1, 0, 0),
                            targetPos.offset(0, 0, 1),
                            targetPos.offset(0, 0, -1)
                        ].some(p => {
                            const block = bot.blockAt(p);
                            return block && block.boundingBox === 'block';
                        });

                        if (!adjSolid) continue;
                        if (bot.entity.position.distanceTo(targetPos) < 1.3) continue;

                        const success = await skills.placeBlock(bot, 'cobblestone', x, y, z);
                        if (success) {
                            placedCount++;
                            await skills.wait(bot, 250);
                        }
                        if (placedCount >= 8) break;
                    }
                }
                if (placedCount >= 8) break;
            }
            if (placedCount >= 8) break;
        }

        // Second pass: Roof at wallHeight + 1 if wall is solid or cobble remaining
        if (placedCount < 8) {
            const roofY = wallHeight + 1;
            for (let x = minX; x <= maxX; x++) {
                for (let z = minZ; z <= maxZ; z++) {
                    const targetPos = new Vec3(x, roofY, z);
                    const b = bot.blockAt(targetPos);
                    if (b && (b.name === 'air' || b.name === 'short_grass')) {
                        const adjSolid = [
                            targetPos.offset(0, -1, 0),
                            targetPos.offset(1, 0, 0),
                            targetPos.offset(-1, 0, 0),
                            targetPos.offset(0, 0, 1),
                            targetPos.offset(0, 0, -1)
                        ].some(p => {
                            const block = bot.blockAt(p);
                            return block && block.boundingBox === 'block';
                        });

                        if (!adjSolid) continue;
                        if (bot.entity.position.distanceTo(targetPos) < 1.3) continue;

                        const success = await skills.placeBlock(bot, 'cobblestone', x, roofY, z);
                        if (success) {
                            placedCount++;
                            await skills.wait(bot, 250);
                        }
                        if (placedCount >= 8) break;
                    }
                }
                if (placedCount >= 8) break;
            }
        }

        bot.chat(`Shelter reinforcement complete: placed ${placedCount} blocks.`);
    }
}```
