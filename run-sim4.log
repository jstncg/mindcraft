// Plan: inspect the shelter bounds, then fill any obvious gaps in floor/walls/roof using available nearby blocks.
// Use bot.findBlocks for structure measurements if needed; here we rely on known shelter bounds from Elias.
const minX = -339, maxX = -330;
const minZ = 77, maxZ = 86;
const minY = 64, maxY = 75;

// Prioritize: floor, lower walls, roof edge, lighting, and bed safety.
const targets = [];

// Floor patches
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    targets.push(new Vec3(x, minY, z));
  }
}

// Wall ring at y=65..74
for (let y = 65; y <= 74; y++) {
  for (let x = minX; x <= maxX; x++) {
    targets.push(new Vec3(x, y, minZ));
    targets.push(new Vec3(x, y, maxZ));
  }
  for (let z = minZ + 1; z <= maxZ - 1; z++) {
    targets.push(new Vec3(minX, y, z));
    targets.push(new Vec3(maxX, y, z));
  }
}

// Roof cap at y=75
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    targets.push(new Vec3(x, maxY, z));
  }
}

let placed = 0;
let bedChecked = false;

for (const pos of targets) {
  const b = bot.blockAt(pos);
  if (!b) continue;
  if (!(b.name === 'air' || b.name === 'short_grass' || b.name === 'flower' || b.name === 'dandelion' || b.name === 'azure_bluet')) continue;

  // Prefer cobblestone if available, else oak_planks, else dirt, else leaf_litter as last resort.
  const inv = bot.inventory.items().map(i => i.name);
  let blockType = null;
  if (inv.includes('cobblestone')) blockType = 'cobblestone';
  else if (inv.includes('oak_planks')) blockType = 'oak_planks';
  else if (inv.includes('dirt')) blockType = 'dirt';
  else if (inv.includes('leaf_litter')) blockType = 'leaf_litter';

  if (!blockType) break;

  const ok = await skills.placeBlock(bot, blockType, pos.x, pos.y, pos.z, 'top');
  if (ok) {
    placed++;
    await skills.wait(bot, 150);
  }

  if (placed >= 12) break;
}

// Secure storage: clear nearby furnace if it has items and there is a chest nearby, then store any leaf_litter if possible.
await skills.clearNearestFurnace(bot);
await skills.putInChest(bot, 'leaf_litter', 1);

// Beds: if a bed is blocking the ceiling or is exposed, ensure it remains accessible; avoid breaking it.
const nearbyBeds = bot.findBlocks({
  matching: (block) => block.name === 'white_bed',
  maxDistance: 12,
  count: 10
});

if (nearbyBeds && nearbyBeds.length > 0) {
  bedChecked = true;
}

// Lighting: place a torch on an interior wall if a torch item exists.
if (bot.inventory.items().some(i => i.name === 'torch')) {
  const lightPos = new Vec3(-334, 71, 81);
  const lightBlock = bot.blockAt(lightPos);
  if (lightBlock && lightBlock.name === 'air') {
    await skills.placeBlock(bot, 'torch', lightPos.x, lightPos.y, lightPos.z, 'side');
  }
}

bot.chat(`Shelter fortification pass done: placed ${placed} blocks${bedChecked ? ', beds confirmed nearby' : ''}.`);"""
