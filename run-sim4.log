// Scan nearby structure blocks to find the shelter's bounds and base Y
const plankBlocks = bot.findBlocks({
    matching: (block) => block.name === 'oak_planks' || block.name === 'cobblestone',
    maxDistance: 16,
    count: 50
});

if (plankBlocks.length > 0) {
    // Find min and max bounds of the shelter
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;
    let maxY = -Infinity;
    let minY = Infinity;

    for (const b of plankBlocks) {
        if (b.x < minX) minX = b.x;
        if (b.x > maxX) maxX = b.x;
        if (b.z < minZ) minZ = b.z;
        if (b.z > maxZ) maxZ = b.z;
        if (b.y < minY) minY = b.y;
        if (b.y > maxY) maxY = b.y;
    }

    bot.chat(`Found structure from (${minX},${minY},${minZ}) to (${maxX},${maxY},${maxZ}). Working on roofing/walls!`);

    // Target roof height: maxY + 1 or at least 3 blocks above base
    const roofY = Math.max(maxY, minY + 3);

    // Place planks on roof if air
    let placed = 0;
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            const targetPos = new Vec3(x, roofY, z);
            const block = bot.blockAt(targetPos);
            if (block && block.name === 'air') {
                // Check if we have oak_planks
                const plankItem = bot.inventory.items().find(i => i.name === 'oak_planks');
                if (!plankItem) break;
                
                const success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                if (success) {
                    placed++;
                    await skills.wait(bot, 200);
                }
            }
            if (placed >= 15) break;
        }
        if (placed >= 15) break;
    }
    bot.chat(`Placed ${placed} roof blocks.`);
} else {
    // If no planks found, find beds or build nearby
    const bed = bot.findBlock({
        matching: (block) => block.name.endsWith('_bed'),
        maxDistance: 16
    });

    if (bed) {
        bot.chat(`Building shelter overhead around bed at ${bed.position}`);
        const baseY = bed.position.y;
        const roofY = baseY + 3;
        for (let dx = -1; dx <= 1; dx++) {
            for (let dz = -1; dz <= 1; dz++) {
                const targetPos = bed.position.offset(dx, 3, dz);
                const block = bot.blockAt(targetPos);
                if (block && block.name === 'air') {
                    await skills.placeBlock(bot, 'oak_planks', targetPos.x, targetPos.y, targetPos.z);
                    await skills.wait(bot, 250);
                }
            }
        }
    } else {
        await skills.wait(bot, 500);
    }
}```
