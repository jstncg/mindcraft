      if (apple) {
        await bot.equip(apple, 'hand');
        await bot.consume();
        await skills.wait(bot, 500);
        break;
      }
    }
  }
}

// If still no food, eat any rotten flesh or seeds? We have saplings but can't eat. Try eating a spider eye if any?
// Finally fallback: if hunger still 0 and health < 2, ask for help or go to nearest village? Just log status.
console.log(`Health: ${bot.health}, Hunger: ${bot.food}`);
await skills.wait(bot, 1000);```
