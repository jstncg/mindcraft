// Fortify the shelter at the given bounds from Elias.
// Use the reported shelter bounds, not bot.entity.position.y, for all height checks.
const minX = -347, maxX = -337;
const minZ = 70, maxZ = 79;
const minY = 66, maxY = 77;

// Find the shelter's roof/base layers from the discovered bounds.
let solidYs = {};
for (let y = minY; y <= maxY; y++) {
  let count = 0;
  for (let x = minX; x <= maxX; x++) {
    for (let z = minZ; z <= maxZ; z++) {
      const b = bot.blockAt(new Vec3(x, y, z));
      if (b && b.name !== 'air' && b.name !== 'cave_air') count++;
    }
  }
  solidYs[y] = count;
}
let roofY = minY;
let best = -1;
for (const [yStr, count] of Object.entries(solidYs)) {
  const y = Number(yStr);
  if (count > best) {
    best = count;
    roofY = y;
  }
}

// Light interior first if we can.
let torchesPlaced = 0;
for (let x = minX + 1; x <= maxX - 1; x += 2) {
  for (let z = minZ + 1; z <= maxZ - 1; z += 2) {
    // place torch on top of floor blocks where possible
    const floorY = roofY - 1;
    const floorBlock = bot.blockAt(new Vec3(x, floorY, z));
    const above = bot.blockAt(new Vec3(x, floorY + 1, z));
    if (floorBlock && floorBlock.name !== 'air' && floorBlock.name !== 'cave_air' && above && (above.name === 'air' || above.name === 'cave_air')) {
      const ok = await skills.placeBlock(bot, 'torch', x, floorY + 1, z, 'top');
      if (ok) {
        torchesPlaced++;
        await skills.wait(bot, 50);
      }
    }
  }
}

// Patch roof gaps using oak planks, but only where a supporting edge exists.
let roofPlaced = 0;
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    const b = bot.blockAt(new Vec3(x, roofY, z));
    if (b && (b.name === 'air' || b.name === 'cave_air')) {
      const neighbors = [
        bot.blockAt(new Vec3(x + 1, roofY, z)),
        bot.blockAt(new Vec3(x - 1, roofY, z)),
        bot.blockAt(new Vec3(x, roofY, z + 1)),
        bot.blockAt(new Vec3(x, roofY, z - 1)),
        bot.blockAt(new Vec3(x, roofY - 1, z)),
      ];
      if (neighbors.some(n => n && n.name !== 'air' && n.name !== 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
        if (ok) {
          roofPlaced++;
          await skills.wait(bot, 50);
        }
      }
    }
  }
}

// Add a simple exterior perimeter wall around the shelter footprint one block above the floor.
let wallPlaced = 0;
for (let x = minX; x <= maxX; x++) {
  for (const z of [minZ, maxZ]) {
    for (let y = roofY - 3; y <= roofY - 1; y++) {
      const p = new Vec3(x, y, z);
      const b = bot.blockAt(p);
      if (b && (b.name === 'air' || b.name === 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'cobblestone', x, y, z);
        if (ok) {
          wallPlaced++;
          await skills.wait(bot, 30);
        }
      }
    }
  }
}
for (let z = minZ; z <= maxZ; z++) {
  for (const x of [minX, maxX]) {
    for (let y = roofY - 3; y <= roofY - 1; y++) {
      const p = new Vec3(x, y, z);
      const b = bot.blockAt(p);
      if (b && (b.name === 'air' || b.name === 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'cobblestone', x, y, z);
        if (ok) {
          wallPlaced++;
          await skills.wait(bot, 30);
        }
      }
    }
  }
}

// Try to sleep if possible.
await skills.goToBed(bot);

bot.chat(`Fortified spawn shelter: roof ${roofPlaced}, walls ${wallPlaced}, torches ${torchesPlaced}.`);"""
