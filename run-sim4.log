// Scan communal shelter around (-331, 81) for roof and wall gaps, and seal them with oak_planks
let planks = bot.findBlocks({
    matching: (b) => b && (b.name === 'oak_planks' || b.name === 'cobblestone'),
    maxDistance: 16,
    count: 200
});

if (planks.length > 0) {
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;
    let minY = Infinity, maxY = -Infinity;

    for (const p of planks) {
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.z < minZ) minZ = p.z;
        if (p.z > maxZ) maxZ = p.z;
        if (p.y < minY) minY = p.y;
        if (p.y > maxY) maxY = p.y;
    }

    bot.chat(`Shelter bounds: X [${minX}, ${maxX}], Y [${minY}, ${maxY}], Z [${minZ}, ${maxZ}]`);

    // The roof is typically at maxY. Let's inspect maxY (or maxY - 1 if maxY is an outlier)
    let roofY = maxY;
    // Count planks at maxY vs maxY-1 to find the main roof plane
    let countAtMax = planks.filter(p => p.y === maxY).length;
    let countAtSub = planks.filter(p => p.y === maxY - 1).length;
    if (countAtSub > countAtMax && countAtMax <= 2) {
        roofY = maxY - 1;
    }

    bot.chat(`Targeting roof gaps at Y=${roofY}`);

    let placedCount = 0;
    // Scan within shelter bounds
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            if (placedCount >= 10) break;
            let block = bot.blockAt(new Vec3(x, roofY, z));
            if (block && block.name === 'air') {
                // Check if there is an adjacent solid block to build off of
                let neighbors = [
                    bot.blockAt(new Vec3(x + 1, roofY, z)),
                    bot.blockAt(new Vec3(x - 1, roofY, z)),
                    bot.blockAt(new Vec3(x, roofY, z + 1)),
                    bot.blockAt(new Vec3(x, roofY, z - 1)),
                    bot.blockAt(new Vec3(x, roofY - 1, z))
                ];
                let hasAdjacent = neighbors.some(n => n && n.name !== 'air');
                if (hasAdjacent) {
                    let success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                    if (success) {
                        placedCount++;
                        await skills.wait(bot, 250);
                    }
                }
            }
        }
    }

    bot.chat(`Patched ${placedCount} roof gaps.`);
} else {
    bot.chat("No shelter planks found nearby to inspect.");
}```
