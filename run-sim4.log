```// Fortify shelter walls and roof around (-331, 73, 81)
const shelterPos = new Vec3(-331, 73, 81);

// Move towards shelter center if too far
if (bot.entity.position.distanceTo(shelterPos) > 6) {
    await skills.goToNearestBlock(bot, 'oak_planks', 2, 16);
}

// Find existing shelter blocks to determine actual structure bounds
const blocks = bot.findBlocks({
    matching: ['oak_planks', 'cobblestone', 'dirt'].map(n => bot.registry.blocksByName[n].id),
    maxDistance: 16,
    count: 300
});

if (blocks.length > 0) {
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;
    let minY = Infinity, maxY = -Infinity;

    for (const p of blocks) {
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.z < minZ) minZ = p.z;
        if (p.z > maxZ) maxZ = p.z;
        if (p.y < minY) minY = p.y;
        if (p.y > maxY) maxY = p.y;
    }

    bot.chat(`Shelter bounds: X [${minX}, ${maxX}], Z [${minZ}, ${maxZ}], Y [${minY}, ${maxY}]`);

    let placed = 0;
    const roofY = maxY;

    // Check roof layer first for any air holes
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            const planksLeft = bot.inventory.items().filter(i => i.name === 'oak_planks').reduce((a, b) => a + b.count, 0);
            if (planksLeft <= 0) break;

            const pos = new Vec3(x, roofY, z);
            const block = bot.blockAt(pos);
            if (block && (block.name === 'air' || block.name === 'cave_air')) {
                // Try placing
                const success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                if (success) {
                    placed++;
                    await skills.wait(bot, 150);
                }
            }
            if (placed >= 12) break;
        }
        if (placed >= 12) break;
    }

    bot.chat(`Fortified shelter with ${placed} oak planks.`);
} else {
    bot.chat("No shelter blocks found nearby!");
}```
