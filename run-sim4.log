Generated code: """
// Scan communal area around beds and build shelter walls
const bedPositions = bot.findBlocks({
    matching: (b) => b && b.name.includes('bed'),
    maxDistance: 16,
    count: 10
});

const cobblePositions = bot.findBlocks({
    matching: (b) => b && b.name === 'cobblestone',
    maxDistance: 16,
    count: 30
});

bot.chat(`Found ${bedPositions.length} beds and ${cobblePositions.length} existing cobble blocks.`);

let baseY = 70;
if (cobblePositions.length > 0) {
    baseY = cobblePositions[0].y;
} else if (bedPositions.length > 0) {
    baseY = bedPositions[0].y;
}

// Let's create or reinforce a wall around the shelter perimeter.
// If beds are around (-335, 70, 84), let's place cobblestone blocks along an open boundary (e.g. z = 86 or z = 82)
// Make sure we don't overwrite beds or chests or furnaces.
const targetPositions = [
    new Vec3(-336, baseY, 86),
    new Vec3(-335, baseY, 86),
    new Vec3(-334, baseY, 86),
    new Vec3(-333, baseY, 86),
    new Vec3(-332, baseY, 86),
    new Vec3(-336, baseY + 1, 86),
    new Vec3(-335, baseY + 1, 86),
    new Vec3(-334, baseY + 1, 86),
    new Vec3(-333, baseY + 1, 86),
    new Vec3(-332, baseY + 1, 86),
];

for (const target of targetPositions) {
    const block = bot.blockAt(target);
    if (!block || block.name === 'air' || block.name === 'short_grass' || block.name === 'tall_grass') {
        if (block && block.name.includes('grass')) {
            await skills.breakBlockAt(bot, target.x, target.y, target.z);
        }
        const placed = await skills.placeBlock(bot, 'cobblestone', target.x, target.y, target.z);
        if (placed) {
            await skills.wait(bot, 200);
        }
    }
}"""
