// Locate the communal shelter structure and continue building the roof
// Find existing shelter blocks (oak_planks and cobblestone)
const shelterBlocks = bot.findBlocks({
    matching: ['oak_planks', 'cobblestone'].map(name => bot.registry.blocksByName[name].id),
    maxDistance: 32,
    count: 200
});

if (shelterBlocks.length === 0) {
    bot.chat("Looking for shelter blocks near spawn...");
} else {
    // Find bounding box and highest Y level of the structure
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;
    let minY = Infinity, maxY = -Infinity;

    for (const pos of shelterBlocks) {
        if (pos.x < minX) minX = pos.x;
        if (pos.x > maxX) maxX = pos.x;
        if (pos.z < minZ) minZ = pos.z;
        if (pos.z > maxZ) maxZ = pos.z;
        if (pos.y < minY) minY = pos.y;
        if (pos.y > maxY) maxY = pos.y;
    }

    bot.chat(`Shelter bounds: X [${minX}, ${maxX}], Z [${minZ}, ${maxZ}], Y [${minY}, ${maxY}]`);

    // The roof should be at maxY or maxY + 1 depending on whether walls are finished
    // If maxY is wall height (say minY + 3 or minY + 4), roof goes across at maxY
    const roofY = maxY;

    let placedCount = 0;
    // Walk/navigate closer if too far
    const targetCenter = new Vec3(Math.floor((minX + maxX) / 2), roofY, Math.floor((minZ + maxZ) / 2));
    
    // Fill in open air blocks on the roof layer
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            const plankCount = bot.inventory.items().filter(i => i.name === 'oak_planks').reduce((acc, cur) => acc + cur.count, 0);
            if (plankCount <= 0) {
                bot.chat("Ran out of oak planks for roofing!");
                break;
            }

            const targetPos = new Vec3(x, roofY, z);
            const block = bot.blockAt(targetPos);
            if (block && (block.name === 'air' || block.name === 'cave_air')) {
                // Check distance, move closer if needed
                if (bot.entity.position.distanceTo(targetPos) > 4.5) {
                    await skills.goToNearestBlock(bot, 'oak_planks', 3, 16);
                }

                const placed = await skills.placeBlock(bot, 'oak_planks', targetPos.x, targetPos.y, targetPos.z);
                if (placed) {
                    placedCount++;
                    await skills.wait(bot, 200);
                }
            }
            if (placedCount >= 16) break;
        }
        if (placedCount >= 16) break;
    }

    bot.chat(`Placed ${placedCount} roof blocks over the shelter!`);
}"""
