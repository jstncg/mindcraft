// Scan the shelter layout and place roof blocks overhead to protect against phantoms and hostile mobs.
(async () => {
    // Find existing shelter foundation or beds
    const beds = bot.findBlocks({
        matching: (block) => block.name.includes('bed'),
        maxDistance: 16,
        count: 10
    });
    const planks = bot.findBlocks({
        matching: (block) => block.name === 'oak_planks' || block.name === 'cobblestone',
        maxDistance: 16,
        count: 100
    });

    let baseY = 73;
    if (beds.length > 0) {
        baseY = beds[0].y;
    } else if (planks.length > 0) {
        const yCoords = planks.map(p => p.y);
        baseY = Math.min(...yCoords);
    }

    // Shelter walls are typically 3-4 blocks high above base, so roof layer should be at baseY + 3 or baseY + 4
    const roofY = baseY + 3; // head clearance of 2-3 blocks

    // Let's identify the bounding box of the shelter structure based on planks/beds
    let minX = -335, maxX = -328, minZ = 78, maxZ = 85;
    if (planks.length > 0) {
        const xs = planks.map(p => p.x);
        const zs = planks.map(p => p.z);
        minX = Math.max(Math.min(...xs), -336);
        maxX = Math.min(Math.max(...xs), -327);
        minZ = Math.max(Math.min(...zs), 77);
        maxZ = Math.min(Math.max(...zs), 86);
    }

    bot.chat(`Sealing roof at height ${roofY} over ${minX},${minZ} to ${maxX},${maxZ}. Watch out, Bjorn fell to a pillager!`);

    // Place planks on the roof level where there is air
    let placedCount = 0;
    for (let x = minX; x <= maxX; x++) {
        for (let z = minZ; z <= maxZ; z++) {
            // Check current block
            const currentBlock = bot.blockAt(new Vec3(x, roofY, z));
            if (currentBlock && currentBlock.name === 'air') {
                // Verify we have planks
                const plankItem = bot.inventory.items().find(i => i.name.includes('planks'));
                if (!plankItem) {
                    bot.chat("Out of planks for the roof!");
                    return;
                }

                // Try placing block
                const success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                if (success) {
                    placedCount++;
                    await skills.wait(bot, 150);
                }
            }
        }
    }

    bot.chat(`Placed ${placedCount} roof blocks.`);
})();"""
