```// Place remaining cobblestone to patch wall gaps and inform Ren
const center = new Vec3(-333, 67, 83);
const structureBlocks = bot.findBlocks({
    point: center,
    matching: (b) => b && (b.name === 'cobblestone' || b.name === 'oak_planks' || b.name === 'furnace' || b.name === 'chest' || b.name === 'white_bed'),
    maxDistance: 12,
    count: 150
});

if (structureBlocks.length === 0) {
    bot.chat("No shelter blocks found nearby!");
} else {
    let minY = Infinity, maxY = -Infinity;
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;

    for (const pos of structureBlocks) {
        if (pos.y < minY) minY = pos.y;
        if (pos.y > maxY) maxY = pos.y;
        if (pos.x < minX) minX = pos.x;
        if (pos.x > maxX) maxX = pos.x;
        if (pos.z < minZ) minZ = pos.z;
        if (pos.z > maxZ) maxZ = pos.z;
    }

    const wallHeight = minY + 3;
    let placed = 0;
    const cobbleCount = bot.inventory.items().filter(i => i.name === 'cobblestone').reduce((sum, i) => sum + i.count, 0);

    bot.chat(`Shelter bounds: X[${minX}, ${maxX}] Z[${minZ}, ${maxZ}] Y[${minY}, ${maxY}]. Placing remaining ${cobbleCount} cobble...`);

    // Scan for gaps along perimeter from minY+1 to wallHeight
    gapLoop:
    for (let y = minY + 1; y <= wallHeight; y++) {
        for (let x = minX; x <= maxX; x++) {
            for (let z = minZ; z <= maxZ; z++) {
                const isPerimeter = (x === minX || x === maxX || z === minZ || z === maxZ);
                if (!isPerimeter) continue;

                // Leave one 1-wide entrance at (minX, y, 83) if y <= minY + 2
                if (x === minX && z === 83 && y <= minY + 2) continue;

                const targetPos = new Vec3(x, y, z);
                const block = bot.blockAt(targetPos);
                if (block && (block.name === 'air' || block.name === 'short_grass' || block.name === 'tall_grass')) {
                    // Check if adjacent to solid block
                    const adjPositions = [
                        targetPos.offset(0, -1, 0),
                        targetPos.offset(1, 0, 0),
                        targetPos.offset(-1, 0, 0),
                        targetPos.offset(0, 0, 1),
                        targetPos.offset(0, 0, -1)
                    ];
                    const hasSolidNeighbor = adjPositions.some(p => {
                        const b = bot.blockAt(p);
                        return b && b.boundingBox === 'block';
                    });

                    if (!hasSolidNeighbor) continue;
                    if (bot.entity.position.distanceTo(targetPos) < 1.3) continue;

                    const ok = await skills.placeBlock(bot, 'cobblestone', x, y, z);
                    if (ok) {
                        placed++;
                        await skills.wait(bot, 300);
                        if (placed >= cobbleCount) break gapLoop;
                    }
                }
            }
        }
    }

    // If still have cobblestone, place on roof
    if (placed < cobbleCount) {
        const roofY = wallHeight + 1;
        roofLoop:
        for (let x = minX; x <= maxX; x++) {
            for (let z = minZ; z <= maxZ; z++) {
                const targetPos = new Vec3(x, roofY, z);
                const block = bot.blockAt(targetPos);
                if (block && block.name === 'air') {
                    const adjPositions = [
                        targetPos.offset(0, -1, 0),
                        targetPos.offset(1, 0, 0),
                        targetPos.offset(-1, 0, 0),
                        targetPos.offset(0, 0, 1),
                        targetPos.offset(0, 0, -1)
                    ];
                    const hasSolidNeighbor = adjPositions.some(p => {
                        const b = bot.blockAt(p);
                        return b && b.boundingBox === 'block';
                    });

                    if (!hasSolidNeighbor) continue;
                    if (bot.entity.position.distanceTo(targetPos) < 1.3) continue;

                    const ok = await skills.placeBlock(bot, 'cobblestone', x, roofY, z);
                    if (ok) {
                        placed++;
                        await skills.wait(bot, 300);
                        if (placed >= cobbleCount) break roofLoop;
                    }
                }
            }
        }
    }

    bot.chat(`Ren, I placed ${placed} blocks. The west wall (X=${minX}) and the roof at Y=${wallHeight + 1} need the most work.`);
}```
