```
// Fortify the communal shelter walls/roof using our oak_planks
const center = new Vec3(-331, 72, 81);

// Find existing structure blocks
const plankIds = bot.registry.blocksByName['oak_planks'].id;
const cobbleIds = bot.registry.blocksByName['cobblestone'].id;
const structureBlocks = bot.findBlocks({
    matching: [plankIds, cobbleIds],
    maxDistance: 12,
    count: 200
});

if (structureBlocks.length > 0) {
    let minY = Infinity, maxY = -Infinity;
    let minX = Infinity, maxX = -Infinity;
    let minZ = Infinity, maxZ = -Infinity;

    for (const bPos of structureBlocks) {
        if (bPos.y < minY) minY = bPos.y;
        if (bPos.y > maxY) maxY = bPos.y;
        if (bPos.x < minX) minX = bPos.x;
        if (bPos.x > maxX) maxX = bPos.x;
        if (bPos.z < minZ) minZ = bPos.z;
        if (bPos.z > maxZ) maxZ = bPos.z;
    }

    bot.chat(`Shelter bounds: X[${minX}..${maxX}] Y[${minY}..${maxY}] Z[${minZ}..${maxZ}]`);

    // Ensure bounds are reasonable for a 5x5 to 7x7 communal shelter
    const wallMinX = Math.max(minX, -335);
    const wallMaxX = Math.min(maxX, -327);
    const wallMinZ = Math.max(minZ, 77);
    const wallMaxZ = Math.min(maxZ, 85);
    const wallHeight = 3; // 3 blocks tall walls above base

    let placed = 0;

    // Check walls perimeter first
    for (let y = minY + 1; y <= minY + wallHeight; y++) {
        for (let x = wallMinX; x <= wallMaxX; x++) {
            for (let z = wallMinZ; z <= wallMaxZ; z++) {
                // Perimeter check
                const isWall = (x === wallMinX || x === wallMaxX || z === wallMinZ || z === wallMaxZ);
                // Leave a 1-wide opening for entrance at south or north middle if at lower levels
                const isDoorway = (x === -331 && z === wallMinZ && (y === minY + 1 || y === minY + 2));
                
                if (isWall && !isDoorway) {
                    const block = bot.blockAt(new Vec3(x, y, z));
                    if (block && (block.name === 'air' || block.name === 'short_grass')) {
                        const plankCount = bot.inventory.items().filter(i => i.name === 'oak_planks').reduce((acc, cur) => acc + cur.count, 0);
                        if (plankCount === 0) break;

                        const success = await skills.placeBlock(bot, 'oak_planks', x, y, z);
                        if (success) {
                            placed++;
                            await skills.wait(bot, 250);
                        }
                    }
                }
            }
        }
    }

    // If we still have planks, check roof gaps at minY + wallHeight + 1
    const roofY = minY + wallHeight + 1;
    for (let x = wallMinX; x <= wallMaxX; x++) {
        for (let z = wallMinZ; z <= wallMaxZ; z++) {
            const plankCount = bot.inventory.items().filter(i => i.name === 'oak_planks').reduce((acc, cur) => acc + cur.count, 0);
            if (plankCount === 0) break;

            const block = bot.blockAt(new Vec3(x, roofY, z));
            if (block && block.name === 'air') {
                const success = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
                if (success) {
                    placed++;
                    await skills.wait(bot, 250);
                }
            }
        }
    }

    bot.chat(`Placed ${placed} oak planks to fortify shelter.`);
} else {
    bot.chat("Could not detect existing structure blocks nearby.");
}```
