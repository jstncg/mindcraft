// Fortify the spawn shelter: seal any roof/wall gaps, then add lighting inside.
// Use the structure's actual base/roof levels from nearby blocks, not bot Y.
const centerX = -331;
const centerZ = 81;

// Find existing shelter blocks to infer structure Y levels.
const nearbyPlanks = bot.findBlocks({
  matching: b => b.name === 'oak_planks' || b.name === 'cobblestone',
  maxDistance: 12,
  count: 64
});

let ys = nearbyPlanks.map(p => p.y);
if (ys.length === 0) {
  // Fallback only if structure blocks aren't found nearby.
  ys = [73, 74, 75, 76];
}

const baseY = Math.min(...ys);
const roofY = Math.max(...ys);

// Search a small shell around the shelter footprint for air holes at roof/wall height.
const targetYs = [roofY, roofY + 1];
const targets = [];
for (let y of targetYs) {
  for (let x = -335; x <= -328; x++) {
    for (let z = 78; z <= 86; z++) {
      const block = bot.blockAt(new Vec3(x, y, z));
      if (block && block.name === 'air') {
        // Only patch spots with nearby support or that are clearly part of the shell.
        targets.push(new Vec3(x, y, z));
      }
    }
  }
}

// Place planks to seal holes. Try from lowest roof layer upward.
for (const pos of targets) {
  await skills.placeBlock(bot, 'oak_planks', pos.x, pos.y, pos.z, 'side');
}

// Add lighting inside along the floor/wall line.
const torchSpots = [
  new Vec3(centerX - 2, baseY + 1, centerZ - 2),
  new Vec3(centerX + 2, baseY + 1, centerZ - 2),
  new Vec3(centerX - 2, baseY + 1, centerZ + 2),
  new Vec3(centerX + 2, baseY + 1, centerZ + 2),
];

for (const pos of torchSpots) {
  const b = bot.blockAt(pos);
  if (!b || b.name === 'air') {
    await skills.placeBlock(bot, 'torch', pos.x, pos.y, pos.z, 'side');
  }
}

// Quick final check for hostile mobs and then settle.
await skills.defendSelf(bot, 8);"""
