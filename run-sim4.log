// Build walls around the shelter in a perimeter defensive pattern
// Current position is -336, 73, 80 (shelter center)
// Use available oak_planks (30) and cobblestone (20) to build walls

let pos = world.getPosition(bot);
let baseX = -336;
let baseY = 73;
let baseZ = 80;

// Build a perimeter wall pattern around the shelter
// Make a 7x7 square with walls on all sides, leaving one gap for door
let wallPositions = [];

// North wall (z - 3)
for (let x = baseX - 3; x <= baseX + 3; x++) {
  wallPositions.push([x, baseY, baseZ - 3]);
  wallPositions.push([x, baseY + 1, baseZ - 3]);
}

// South wall (z + 3)
for (let x = baseX - 3; x <= baseX + 3; x++) {
  wallPositions.push([x, baseY, baseZ + 3]);
  wallPositions.push([x, baseY + 1, baseZ + 3]);
}

// East wall (x + 3)
for (let z = baseZ - 3; z <= baseZ + 3; z++) {
  wallPositions.push([baseX + 3, baseY, z]);
  wallPositions.push([baseX + 3, baseY + 1, z]);
}

// West wall (x - 3), but leave gap at z for door
for (let z = baseZ - 3; z <= baseZ + 3; z++) {
  if (z !== baseZ) { // Leave door opening at center
    wallPositions.push([baseX - 3, baseY, z]);
    wallPositions.push([baseX - 3, baseY + 1, z]);
  }
}

// Place walls, alternating between oak_planks and cobblestone
let planksUsed = 0;
let cobbleUsed = 0;
let placedCount = 0;

for (let i = 0; i < wallPositions.length; i++) {
  let [x, y, z] = wallPositions[i];
  let blockType = (i % 2 === 0) ? 'oak_planks' : 'cobblestone';
  
  // Check we have materials
  if (blockType === 'oak_planks' && planksUsed >= 30) continue;
  if (blockType === 'cobblestone' && cobbleUsed >= 20) continue;
  
  let placed = await skills.placeBlock(bot, blockType, x, y, z, 'top');
  if (placed) {
    placedCount++;
    if (blockType === 'oak_planks') planksUsed++;
    else cobbleUsed++;
  }
  
  await skills.wait(bot, 100);
}

bot.chat(`Built walls! Placed ${placedCount} blocks. Planks: ${planksUsed}/30, Cobblestone: ${cobbleUsed}/20`);```
