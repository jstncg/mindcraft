// Fortify the spawn shelter: find the structure bounds, identify missing floor/wall/roof spots,
// then add lighting and secure storage if possible. Use base Y from found blocks, not bot position.

const center = new Vec3(-331, 70, 83);
const minX = -339, maxX = -330, minZ = 77, maxZ = 86, minY = 64, maxY = 75;

await skills.defendSelf(bot, 8);

// Try to find usable building blocks nearby / in inventory.
const items = bot.inventory.items().map(i => i.name);
const candidates = ['cobblestone', 'oak_planks', 'stone', 'dirt', 'grass_block', 'gray_wool'];
const blockType = candidates.find(n => items.includes(n)) || 'cobblestone';

// Scan for open spots on shell layers and fill from inside/outside adjacency.
let placed = 0;
const targets = [];

// Floor edge and interior patches near shelter base
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    targets.push(new Vec3(x, 64, z));
  }
}

// Wall ring at y=65..74, prioritize likely gaps.
for (let y = 65; y <= 74; y++) {
  for (let x = minX; x <= maxX; x++) {
    targets.push(new Vec3(x, y, minZ));
    targets.push(new Vec3(x, y, maxZ));
  }
  for (let z = minZ + 1; z <= maxZ - 1; z++) {
    targets.push(new Vec3(minX, y, z));
    targets.push(new Vec3(maxX, y, z));
  }
}

// Roof layer at y=75
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    targets.push(new Vec3(x, 75, z));
  }
}

for (const pos of targets) {
  const block = bot.blockAt(pos);
  if (!block) continue;
  if (!(block.name === 'air' || block.name === 'short_grass' || block.name === 'dandelion' || block.name === 'azure_bluet')) continue;

  // Only place if we likely have a support neighbor.
  const neighbors = [
    bot.blockAt(pos.offset(1, 0, 0)),
    bot.blockAt(pos.offset(-1, 0, 0)),
    bot.blockAt(pos.offset(0, 1, 0)),
    bot.blockAt(pos.offset(0, -1, 0)),
    bot.blockAt(pos.offset(0, 0, 1)),
    bot.blockAt(pos.offset(0, 0, -1))
  ].filter(Boolean);

  const canAttach = neighbors.some(b => b.name !== 'air' && b.boundingBox !== 'empty');
  if (!canAttach) continue;

  const ok = await skills.placeBlock(bot, blockType, pos.x, pos.y, pos.z, 'side');
  if (ok) {
    placed++;
    if (placed >= 8) break;
    await skills.wait(bot, 150);
  }
}
await skills.wait(bot, 300);

// Lighting: place torch if available near interior corners.
if (bot.inventory.items().some(i => i.name === 'torch')) {
  const torchSpots = [
    new Vec3(-338, 66, 78),
    new Vec3(-331, 66, 78),
    new Vec3(-338, 66, 85),
    new Vec3(-331, 66, 85),
  ];
  for (const p of torchSpots) {
    const b = bot.blockAt(p);
    if (b && b.name === 'air') {
      const placedTorch = await skills.placeBlock(bot, 'torch', p.x, p.y, p.z, 'side');
      if (placedTorch) await skills.wait(bot, 120);
    }
  }
}

// Storage: if chest exists nearby, organize a bit by putting spare blocks away.
for (const itemName of ['cobblestone', 'oak_planks', 'stone', 'dirt', 'gray_wool']) {
  if (bot.inventory.items().some(i => i.name === itemName)) {
    await skills.putInChest(bot, itemName, -1);
  }
}

// Beds: ensure any nearby beds remain accessible; no item to place beds from inventory, so just clear access.
const beds = world.getBlocks(bot, 'white_bed', 32) || [];
for (const bedPos of beds) {
  const bp = bedPos.position || bedPos;
  const above = bot.blockAt(bp.offset(0, 1, 0));
  if (above && above.name !== 'air') {
    await skills.breakBlockAt(bot, above.position.x, above.position.y, above.position.z);
  }
}

bot.chat(`Fortification pass complete: placed ${placed} blocks and secured the shelter as best I could.`);"""
