  maxDistance: 8,
  count: 50
});

let baseY = 73;
if (found && found.length) {
  const ys = found.map(p => p.y).sort((a, b) => a - b);
  baseY = ys[Math.floor(ys.length / 2)];
}

// Move into the shelter area if needed.
await skills.wait(bot, 100);

// Try to secure the immediate roof/walls with available blocks.
// Keep it compact around the known shelter footprint.
const wallBlocks = ['cobblestone', 'oak_planks'];
const torchPos = [
  [baseX - 1, baseY + 2, baseZ],
  [baseX + 1, baseY + 2, baseZ],
  [baseX, baseY + 2, baseZ - 1],
  [baseX, baseY + 2, baseZ + 1]
];

// Fill any obvious open vertical edge blocks around the sleep area.
for (const [dx, dz] of [[-1,0],[1,0],[0,-1],[0,1]]) {
  for (let dy = 1; dy <= 2; dy++) {
    const x = baseX + dx;
    const y = baseY + dy;
    const z = baseZ + dz;
    const block = bot.blockAt(new Vec3(x, y, z));
    if (!block || block.name === 'air') {
      for (const mat of wallBlocks) {
        const placed = await skills.placeBlock(bot, mat, x, y, z, 'side');
        if (placed) break;
      }
    }
  }
}

// Add lighting if there are torches available in inventory or via torch item.
for (const [x, y, z] of torchPos) {
  const block = bot.blockAt(new Vec3(x, y, z));
  if (!block || block.name === 'air') {
    await skills.placeBlock(bot, 'torch', x, y, z, 'side');
  }
}

// Ensure beds near the center are unobstructed and ready.
const beds = bot.findBlocks({
  matching: (b) => b && b.name && b.name.endsWith('_bed'),
  maxDistance: 10,
  count: 10
});

if (beds && beds.length) {
  for (const p of beds) {
    // Clear any obstruction above each bed if present.
    const above = bot.blockAt(new Vec3(p.x, p.y + 1, p.z));
    if (above && above.name !== 'air') {
      await skills.breakBlockAt(bot, p.x, p.y + 1, p.z);
    }
  }
}

// Place a couple of extra planks/cobblestone near the shelter entrance if space allows.
const entranceCandidates = [
  [baseX, baseY + 1, baseZ + 2],
  [baseX + 1, baseY + 1, baseZ + 2],
  [baseX - 1, baseY + 1, baseZ + 2]
];

for (const [x, y, z] of entranceCandidates) {
  const block = bot.blockAt(new Vec3(x, y, z));
  if (!block || block.name === 'air') {
    const placed = await skills.placeBlock(bot, 'cobblestone', x, y, z, 'side');
    if (!placed) {
      await skills.placeBlock(bot, 'oak_planks', x, y, z, 'side');
    }
  }
}

// If the shelter has a bed, try sleeping to help pass the night cycle when it arrives.
await skills.goToBed(bot);"""
