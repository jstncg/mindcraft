// Fortify the spawn shelter using the known bounds from Elias.
// Plan:
// 1) Stabilize and inspect the shelter footprint.
// 2) Finish any obvious floor/wall/roof gaps inside bounds.
// 3) Add lighting and secure storage.
// 4) Place beds so nearby players can sleep.

await skills.defendSelf(bot, 8);

const minX = -336, maxX = -330;
const minY = 66, maxY = 77;
const minZ = 80, maxZ = 86;

// Helper to safely place a block if we have it or can use nearby materials.
async function tryPlace(type, x, y, z, face = 'top') {
  return await skills.placeBlock(bot, type, x, y, z, face, false);
}

// Find the shelter floor level by scanning known bounds for the lowest solid layer.
let floorY = 73;
for (let y = minY; y <= maxY; y++) {
  let count = 0;
  for (let x = minX; x <= maxX; x++) {
    for (let z = minZ; z <= maxZ; z++) {
      const b = bot.blockAt(new Vec3(x, y, z));
      if (b && b.boundingBox === 'block') count++;
    }
  }
  if (count >= 10) { floorY = y; break; }
}

// Finish the floor with cobblestone where there are gaps.
for (let x = minX + 1; x <= maxX - 1; x++) {
  for (let z = minZ + 1; z <= maxZ - 1; z++) {
    const b = bot.blockAt(new Vec3(x, floorY, z));
    if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
      await tryPlace('cobblestone', x, floorY, z, 'top');
    }
  }
}

// Reinforce walls up to roof level around the perimeter.
for (let y = floorY + 1; y <= 75; y++) {
  for (let x = minX; x <= maxX; x++) {
    for (const z of [minZ, maxZ]) {
      const b = bot.blockAt(new Vec3(x, y, z));
      if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
        await tryPlace('cobblestone', x, y, z, 'side');
      }
    }
  }
  for (let z = minZ; z <= maxZ; z++) {
    for (const x of [minX, maxX]) {
      const b = bot.blockAt(new Vec3(x, y, z));
      if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
        await tryPlace('cobblestone', x, y, z, 'side');
      }
    }
  }
}

// Roof: patch the top layer at y = 76 if open.
const roofY = 76;
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    const b = bot.blockAt(new Vec3(x, roofY, z));
    if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
      await tryPlace('oak_planks', x, roofY, z, 'top');
    }
  }
}

// Lighting: place torches near corners and center if needed.
const torchSpots = [
  [minX + 1, floorY + 1, minZ + 1],
  [maxX - 1, floorY + 1, minZ + 1],
  [minX + 1, floorY + 1, maxZ - 1],
  [maxX - 1, floorY + 1, maxZ - 1],
  [Math.floor((minX + maxX) / 2), floorY + 1, Math.floor((minZ + maxZ) / 2)]
];
for (const [x, y, z] of torchSpots) {
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
    await tryPlace('torch', x, y, z, 'side');
  }
}

// Secure storage: place a crafting table/furnace-adjacent storage spot near a wall if possible.
await tryPlace('crafting_table', minX + 2, floorY + 1, minZ + 2, 'top');
await tryPlace('furnace', minX + 3, floorY + 1, minZ + 2, 'top');

// Beds: place two beds along the longer wall so everyone can sleep through the night.
const bedPositions = [
  [minX + 2, floorY + 1, maxZ - 2],
  [minX + 4, floorY + 1, maxZ - 2],
  [minX + 6, floorY + 1, maxZ - 2],
];
for (const [x, y, z] of bedPositions) {
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') {
    await tryPlace('white_bed', x, y, z, 'side');
  }
}

// Try to sleep if a bed is already usable.
await skills.goToBed(bot);

await skills.wait(bot, 250);"""
