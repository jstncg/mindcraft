// Recover from the failed sleep attempt.
// Main goal now: finish fortifying the shelter and prepare beds for communal sleeping.
// Since it's not night yet, don't try to sleep again. Improve safety and lighting instead.

const centerX = -331;
const centerZ = 81;

// Base Y must come from the shelter blocks, not my current position.
const shelterBlocks = bot.findBlocks({
  matching: (b) => b && (b.name === 'cobblestone' || b.name === 'oak_planks' || b.name === 'stone'),
  maxDistance: 10,
  count: 80
});

let baseY = 71;
if (shelterBlocks && shelterBlocks.length) {
  const ys = shelterBlocks.map(p => p.y).sort((a, b) => a - b);
  baseY = ys[Math.floor(ys.length / 2)];
}

// Inspect and patch a compact 3x3 perimeter around the shelter floor.
const perimeter = [];
for (let dx = -1; dx <= 1; dx++) {
  for (let dz = -1; dz <= 1; dz++) {
    if (dx === 0 && dz === 0) continue;
    perimeter.push([centerX + dx, baseY, centerZ + dz]);
  }
}

// Patch the lower ring where air gaps may have been left open.
for (const [x, y, z] of perimeter) {
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air') {
    let placed = await skills.placeBlock(bot, 'cobblestone', x, y, z, 'side');
    if (!placed) {
      placed = await skills.placeBlock(bot, 'oak_planks', x, y, z, 'side');
    }
  }
}

// Strengthen the roof edge one block above the shelter floor.
for (const [dx, dz] of [[-1,-1], [0,-1], [1,-1], [-1,1], [0,1], [1,1], [-1,0], [1,0]]) {
  const x = centerX + dx;
  const y = baseY + 2;
  const z = centerZ + dz;
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air') {
    let placed = await skills.placeBlock(bot, 'cobblestone', x, y, z, 'side');
    if (!placed) {
      placed = await skills.placeBlock(bot, 'oak_planks', x, y, z, 'side');
    }
  }
}

// Add torches at accessible corners to keep the sleeping area lit.
const torchSpots = [
  [centerX - 1, baseY + 1, centerZ - 1],
  [centerX + 1, baseY + 1, centerZ - 1],
  [centerX - 1, baseY + 1, centerZ + 1],
  [centerX + 1, baseY + 1, centerZ + 1]
];

for (const [x, y, z] of torchSpots) {
  const b = bot.blockAt(new Vec3(x, y, z));
  if (!b || b.name === 'air') {
    await skills.placeBlock(bot, 'torch', x, y, z, 'side');
  }
}

// Make sure beds in the shelter are unobstructed.
const beds = bot.findBlocks({
  matching: (b) => b && b.name && b.name.endsWith('_bed'),
