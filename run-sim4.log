// Check existing shelter blocks nearby and contribute to building the walls
const plankPositions = bot.findBlocks({
    matching: (block) => block && (block.name === 'oak_planks' || block.name === 'chest' || block.name === 'white_bed'),
    maxDistance: 16,
    count: 50
});

if (plankPositions.length > 0) {
    // Find the base Y of the structure
    let minY = Infinity;
    let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
    
    for (const p of plankPositions) {
        if (p.y < minY) minY = p.y;
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.z < minZ) minZ = p.z;
        if (p.z > maxZ) maxZ = p.z;
    }
    
    bot.chat(`Found structure base at Y=${minY}, bounds [${minX}, ${minZ}] to [${maxX}, ${maxZ}]. Building walls!`);

    // Let's inspect where walls are needed or extend walls up to 3 blocks high
    // We want solid walls around the shelter perimeter
    // Expand bounds slightly if too tight (e.g. 5x5 or whatever the perimeter is)
    let placed = 0;
    
    // Look for empty spots along existing walls or adjacent to planks at Y = minY to minY + 2
    for (let y = minY; y <= minY + 2; y++) {
        for (const basePos of plankPositions) {
            if (placed >= 15) break;
            const target = new Vec3(basePos.x, y, basePos.z);
            const block = bot.blockAt(target);
            if (block && (block.name === 'air' || block.name === 'short_grass' || block.name === 'azure_bluet' || block.name === 'dandelion')) {
                // Check if there is an adjacent solid block to attach to
                const success = await skills.placeBlock(bot, "oak_planks", target.x, target.y, target.z);
                if (success) {
                    placed++;
                    await skills.wait(bot, 200);
                }
            }
        }
    }
    
    if (placed === 0) {
        // Try building along the perimeter outline at minY
        // Outline from minX-1 to maxX+1, minZ-1 to maxZ+1
        for (let y = minY; y <= minY + 2 && placed < 15; y++) {
            for (let x = minX - 1; x <= maxX + 1 && placed < 15; x++) {
                for (let z = minZ - 1; z <= maxZ + 1 && placed < 15; z++) {
                    // Only perimeter
                    const isEdge = (x === minX - 1 || x === maxX + 1 || z === minZ - 1 || z === maxZ + 1);
                    // Leave door opening at z == minZ - 1 && x == Math.floor((minX+maxX)/2)
                    if (isEdge && !(z === minZ - 1 && x === Math.floor((minX + maxX) / 2))) {
                        const target = new Vec3(x, y, z);
                        const block = bot.blockAt(target);
                        if (block && (block.name === 'air' || block.name === 'short_grass' || block.name === 'azure_bluet' || block.name === 'dandelion' || block.name === 'oxeye_daisy')) {
                            const success = await skills.placeBlock(bot, "oak_planks", target.x, target.y, target.z);
                            if (success) {
                                placed++;
                                await skills.wait(bot, 200);
                            }
                        }
                    }
                }
            }
        }
    }
    
    bot.chat(`Placed ${placed} planks on shelter walls.`);
} else {
    // Navigate towards the group coordinates (-331, 69, 81)
    bot.chat("No shelter structure found nearby, moving to spawn shelter coordinates.");
    await skills.goToNearestBlock(bot, "crafting_table", 2, 32);
}"""
