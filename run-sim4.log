let bestCount = -1;
for (let y = minY; y <= maxY; y++) {
  let count = 0;
  for (let x = minX; x <= maxX; x++) {
    for (let z = minZ; z <= maxZ; z++) {
      const b = bot.blockAt(new Vec3(x, y, z));
      if (b && b.name !== 'air' && b.name !== 'cave_air') count++;
    }
  }
  if (count > bestCount) {
    bestCount = count;
    roofY = y;
  }
}

// Seal any roof gaps with oak planks where there is support.
let roofPlaced = 0;
for (let x = minX; x <= maxX; x++) {
  for (let z = minZ; z <= maxZ; z++) {
    const b = bot.blockAt(new Vec3(x, roofY, z));
    if (!b || b.name === 'air' || b.name === 'cave_air') {
      const supports = [
        bot.blockAt(new Vec3(x + 1, roofY, z)),
        bot.blockAt(new Vec3(x - 1, roofY, z)),
        bot.blockAt(new Vec3(x, roofY, z + 1)),
        bot.blockAt(new Vec3(x, roofY, z - 1)),
        bot.blockAt(new Vec3(x, roofY - 1, z)),
      ];
      if (supports.some(s => s && s.name !== 'air' && s.name !== 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'oak_planks', x, roofY, z);
        if (ok) {
          roofPlaced++;
          await skills.wait(bot, 40);
        }
      }
    }
  }
}

// Add lighting inside the shelter on the floor edge spots.
let torchesPlaced = 0;
for (let x = minX + 1; x <= maxX - 1; x += 2) {
  for (let z = minZ + 1; z <= maxZ - 1; z += 2) {
    const floor = roofY - 1;
    const floorBlock = bot.blockAt(new Vec3(x, floor, z));
    const airAbove = bot.blockAt(new Vec3(x, floor + 1, z));
    if (floorBlock && floorBlock.name !== 'air' && floorBlock.name !== 'cave_air' && airAbove && (airAbove.name === 'air' || airAbove.name === 'cave_air')) {
      const ok = await skills.placeBlock(bot, 'torch', x, floor + 1, z, 'top');
      if (ok) {
        torchesPlaced++;
        await skills.wait(bot, 40);
      }
    }
  }
}

// Strengthen the lower perimeter with cobblestone where openings remain.
let wallPlaced = 0;
for (let y = roofY - 3; y <= roofY - 1; y++) {
  for (let x = minX; x <= maxX; x++) {
    for (const z of [minZ, maxZ]) {
      const p = bot.blockAt(new Vec3(x, y, z));
      if (p && (p.name === 'air' || p.name === 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'cobblestone', x, y, z);
        if (ok) {
          wallPlaced++;
          await skills.wait(bot, 25);
        }
      }
    }
  }
  for (let z = minZ; z <= maxZ; z++) {
    for (const x of [minX, maxX]) {
      const p = bot.blockAt(new Vec3(x, y, z));
      if (p && (p.name === 'air' || p.name === 'cave_air')) {
        const ok = await skills.placeBlock(bot, 'cobblestone', x, y, z);
        if (ok) {
          wallPlaced++;
          await skills.wait(bot, 25);
        }
      }
    }
  }
}

bot.chat(`Shelter fortified: ${roofPlaced} roof blocks, ${wallPlaced} wall blocks, ${torchesPlaced} torches.`);"""
